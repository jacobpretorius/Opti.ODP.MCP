{
  "name": "opti-odp-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP server for Optimizely Data Platform (ODP) - GraphQL and REST read access",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Jacob Pretorius"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f odp-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "graphql": "^17.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
